# Root-level env for docker-compose. Copy to .env and fill in.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=storefront

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/storefront

TELEGRAM_BOT_TOKEN=
INTERNAL_API_TOKEN=change-me-to-a-long-random-string

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

CORS_ORIGINS=["http://localhost:5173"]

SHIPPING_FLAT_RATE=4.99
FREE_SHIPPING_THRESHOLD=50.00

VITE_API_BASE_URL=http://localhost:8000
VITE_STRIPE_PUBLISHABLE_KEY=
