# Root-level env for docker-compose. Copy to .env and fill in.

# --- Required ---
# From @BotFather. Telegram initData is validated against it, so it must be the bot that
# opens the Mini App.
TELEGRAM_BOT_TOKEN=
# Guards the /internal/* catalog-management API. Use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_TOKEN=

# Signs admin browser sessions (Telegram Login Widget). Long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SESSION_SECRET=

# --- Stripe (optional: without these the app runs but checkout cannot take payments) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Courier delivery and live tracking (all optional) ---
# Secret Telegram sends back with every bot update, so only Telegram can post locations.
# Letters, digits, "_" and "-" only, up to 256 characters. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty keeps POST /webhooks/telegram switched off (it answers 404).
TELEGRAM_WEBHOOK_SECRET=
# The bot's username (with or without @). Used for the courier's "Open bot chat" button.
TELEGRAM_BOT_USERNAME=
# Public https:// address of the shop (e.g. https://shop.example.com/). The bot answers /start
# with an "Open shop" button to it. Needs the webhook (set_telegram_webhook) to receive /start.
WEBAPP_URL=
# How many orders one courier may hold at once.
MAX_ACTIVE_DELIVERIES_PER_COURIER=3
# A courier position older than this is shown to customers as "last known".
LOCATION_STALE_SECONDS=120
# Map (baked into the frontend at build time). Empty = the public OpenStreetMap server,
# which is fine to try things out but not for real traffic: use a tile provider's URL
# template, e.g. https://tiles.example.com/{z}/{x}/{y}.png, and its required attribution.
MAP_TILE_URL=
# "lat,lng" the map opens on before a pin is placed (default: Berlin)
MAP_DEFAULT_CENTER=
MAP_ATTRIBUTION=

# --- Admin panel ---
# Telegram IDs (comma-separated) that get an owner account on startup. Owners add everyone
# else from the admin panel. Removing an ID here later demotes nobody.
ADMIN_BOOTSTRAP_TELEGRAM_IDS=
# IANA time zone the summary counts "today" in, e.g. Asia/Tashkent or Europe/Berlin.
SHOP_TIMEZONE=UTC
# Variants with this many units or fewer show up as "running low" in the summary.
LOW_STOCK_THRESHOLD=5
# Browser sign-in also needs the bot's domain set with @BotFather /setdomain, and
# TELEGRAM_BOT_USERNAME above (the widget is built from it).

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=storefront

# --- Shipping ---
SHIPPING_FLAT_RATE=4.99
FREE_SHIPPING_THRESHOLD=50.00

# --- Host ports (change if these are taken) ---
WEB_PORT=8080
API_PORT=8000
DB_PORT=5432

# --- Stock reservation ---
# Checkout holds the stock of an unpaid order for this many minutes. After that the order is
# cancelled, its items go back to the customer's cart, and a payment arriving later is refunded.
RESERVATION_TTL_MINUTES=15
# How often the API checks for overdue unpaid orders (0 switches the check off).
RESERVATION_SWEEP_SECONDS=60

# --- Telegram notifications ---
# The bot messages customers (order status, cancellations, refunds), couriers (orders in the
# pool) and owners/dispatchers (new orders, failed refunds). Messages wait in the database and a
# background task sends them every this many seconds (0 switches sending off in this process).
# Buttons in the messages open WEBAPP_URL above, so set it to the shop's https address.
NOTIFICATION_SEND_SECONDS=2
