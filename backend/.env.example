ENV=development

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/storefront
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/storefront_test

# A made-up token is fine locally: it only signs the dev login data (scripts.make_dev_init_data).
# The real bot token belongs in the root .env (Docker / server).
TELEGRAM_BOT_TOKEN=123456:dev-local-test-token
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

INTERNAL_API_TOKEN=change-me-to-a-long-random-string

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
DEFAULT_CURRENCY=UZS

CORS_ORIGINS=["http://localhost:5173"]

SHIPPING_FLAT_RATE=20000
FREE_SHIPPING_THRESHOLD=300000

# Courier delivery (optional). Empty webhook secret = POST /webhooks/telegram answers 404.
# Charset: letters, digits, "_" and "-".
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
MAX_ACTIVE_DELIVERIES_PER_COURIER=3
LOCATION_STALE_SECONDS=120

# Admin panel. Telegram IDs (comma-separated) that get an owner account on startup.
ADMIN_BOOTSTRAP_TELEGRAM_IDS=
# Signs browser sessions; required unless ENV=development.
ADMIN_SESSION_SECRET=
# Browsers drop Secure cookies on plain http; false only for local development.
ADMIN_COOKIE_SECURE=false
MEDIA_ROOT=./media
# Product photos: local (under MEDIA_ROOT) or r2 (a Cloudflare R2 bucket, for hosts without a
# persistent disk; see docs/DEPLOY_FREE_RU.md). r2 needs all four R2_* values.
MEDIA_STORAGE=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SHOP_TIMEZONE=Asia/Tashkent
LOW_STOCK_THRESHOLD=5

# Payments. Locally there is no Telegram or Stripe, so offer cash on delivery.
CASH_ON_DELIVERY_ENABLED=true
TELEGRAM_PAYMENT_PROVIDER_TOKEN=

# Telegram notifications are queued but not sent locally (0 = sender off): with a made-up
# token every attempt would fail anyway. The public address for bot buttons (https only).
NOTIFICATION_SEND_SECONDS=0
WEBAPP_URL=
