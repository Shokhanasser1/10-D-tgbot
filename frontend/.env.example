VITE_API_BASE_URL=http://localhost:8000
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_DEV_MOCK_INIT_DATA=

# Map (courier delivery). All optional.
# The default is the public OpenStreetMap tile server, which is fine for development but not for
# real traffic: set a tile provider's URL template here before launch.
VITE_MAP_TILE_URL=
# "lat,lng" the map opens on when nothing is pinned yet (default: Berlin)
VITE_MAP_DEFAULT_CENTER=
# Attribution text your tile provider requires (default: "© OpenStreetMap contributors")
VITE_MAP_ATTRIBUTION=

# Admin panel: the bot the Telegram Login Widget signs in with (browser sign-in only).
VITE_TELEGRAM_BOT_USERNAME=
